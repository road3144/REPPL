# ─── Docker Registry ─────────────────────────────────────────────────────────
# GitLab Container Registry: registry.gitlab.com/{group}/{project}
REGISTRY_IMAGE=registry.gitlab.com/your-group/s14p21a401

# 배포할 이미지 태그 (CI에서 commit SHA로 자동 설정됨)
TAG=latest

# ─── EC2 ─────────────────────────────────────────────────────────────────────
# EC2 퍼블릭 IP 또는 도메인 (Kafka 외부 접근용)
EC2_HOST=your-ec2-public-ip

# ─── AWS S3 ──────────────────────────────────────────────────────────────────
AWS_ACCESS_KEY=
AWS_SECRET_KEY=
AWS_REGION=ap-northeast-2
AWS_S3_BUCKET=